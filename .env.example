# Copy to .env for local dev. Never commit .env.
DATABASE_URL=postgres://narrator:narrator@localhost:5432/narrator
APP_PASSWORD=change-me
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
ANTHROPIC_API_KEY=
NARRATOR_MODEL=claude-sonnet-5
UTILITY_MODEL=claude-haiku-4-5-20251001
# Self-hosted model instead of Claude: set LLM_BASE_URL to an Anthropic-compatible server (Ollama)
# and name its model in both MODEL settings (one model; swapping models costs a reload each call).
# LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=
# NARRATOR_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
# UTILITY_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
# Narrator thinking depth (Claude only): low | medium | high
NARRATOR_EFFORT=medium
PORT=3000
LOG_LEVEL=info
