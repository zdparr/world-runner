# Copy to .env for local dev. Never commit .env.
DATABASE_URL=postgres://narrator:narrator@localhost:5432/narrator
APP_PASSWORD=change-me
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
ANTHROPIC_API_KEY=
NARRATOR_MODEL=claude-sonnet-5
UTILITY_MODEL=claude-haiku-4-5-20251001
# Narrator thinking depth: low | medium | high
NARRATOR_EFFORT=medium
PORT=3000
LOG_LEVEL=info
