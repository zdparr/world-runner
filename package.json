{
  "name": "narrator",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w @narrator/server\" \"npm run dev -w @narrator/web\"",
    "build": "npm run build -w @narrator/web && npm run build -w @narrator/server",
    "start": "node server/dist/index.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w @narrator/server",
    "db:up": "docker compose up -d db",
    "db:generate": "npm run db:generate -w @narrator/server",
    "db:migrate": "node server/dist/migrate.js",
    "db:migrate:dev": "npm run db:migrate:dev -w @narrator/server",
    "seed": "tsx server/src/db/seed/run.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
